{
  "name": "in-app-boarding",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ib/db prisma:generate",
    "db:push": "pnpm --filter @ib/db prisma:push",
    "db:studio": "pnpm --filter @ib/db prisma:studio"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
