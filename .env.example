# Supabase project (https://supabase.com)
# Use the new API key system: Project Settings -> API Keys
#   Publishable key  -> safe in browser, format sb_publishable_...
#   Secret key       -> server-only, format sb_secret_...
# (Legacy anon / service_role JWT keys still work if you paste them here.)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres connection strings (use Supavisor pooled URL for DATABASE_URL)
DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Used by jose to sign builder JWTs (>= 32 random bytes recommended)
JWT_SECRET=replace-with-a-long-random-string

# Public URL the dashboard runs on (used by SDK / demo client to call APIs)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# ----- demo-client only -----
# Paste a dev_xxx key from a project you create in the dashboard
NEXT_PUBLIC_IB_KEY=
NEXT_PUBLIC_IB_API_URL=http://localhost:3000
